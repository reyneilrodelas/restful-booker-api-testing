    {
      "name": "Booking Retrieval",
      "item": [
        {
          "name": "Get Booking IDs",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Booking retrieved successfully\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "if (pm.response.code === 200) {\r",
                  "    const response = pm.response.json();\r",
                  "\r",
                  "    pm.test(\"Booking contains required fields\", function () {\r",
                  "        pm.expect(response).to.have.property(\"firstname\");\r",
                  "        pm.expect(response).to.have.property(\"lastname\");\r",
                  "        pm.expect(response).to.have.property(\"totalprice\");\r",
                  "        pm.expect(response).to.have.property(\"bookingdates\");\r",
                  "    });\r",
                  "\r",
                  "    pm.test(\"Booking ID is valid\", function () {\r",
                  "        pm.expect(Number(pm.environment.get(\"bookingId\"))).to.be.above(0);\r",
                  "    });\r",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
