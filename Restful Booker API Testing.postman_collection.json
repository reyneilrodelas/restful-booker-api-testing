    {
      "name": "Create Booking",
      "item": [
        {
          "name": "Create Booking",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Booking created successfully\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "if (pm.response.code === 200) {\r",
                  "    const response = pm.response.json();\r",
                  "\r",
                  "    pm.test(\"Booking ID is generated\", function () {\r",
                  "        pm.expect(response.bookingid).to.exist;\r",
                  "        pm.expect(response.booking).to.exist;\r",
                  "    });\r",
                  "\r",
                  "    pm.environment.set(\"bookingId\", response.bookingid);\r",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
